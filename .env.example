# ============================================================================
# NemoSec & Socratic PR Auditor — Environment Configuration
# ============================================================================

# Nebius Token Factory API Configuration (OpenAI-compatible endpoint)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Primary NVIDIA Nemotron Model on Nebius Token Factory
# Options:
#   - nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B  (Default / Fast)
#   - nvidia/nemotron-3-super-120b           (Deep Reasoning)
#   - nvidia/nemotron-3.5-super-vl           (Multimodal / Vision-Language)
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# GitHub Integration (for fetching PRs, posting Socratic PR comments, and pushing fixes)
GITHUB_TOKEN=your_github_personal_access_token_here
DEFAULT_GITHUB_REPO=Harinath0225/nemosec-pr-auditor

# Optional Snyk CLI Token (if using Snyk CLI alongside built-in live AST Snyk engine)
SNYK_TOKEN=

# Backend Server Port
PORT=8000
